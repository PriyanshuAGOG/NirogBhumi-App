# Firebase Web App config for the Nirog Bhumi console.
# Register a Web App in the Firebase console (Project settings -> Your apps -> Web)
# for project `nirog-bhumi-app`, then copy the generated values here into a
# local `.env` file (which is gitignored). Do NOT commit real values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=nirog-bhumi-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nirog-bhumi-app
VITE_FIREBASE_STORAGE_BUCKET=nirog-bhumi-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=126409331898
VITE_FIREBASE_APP_ID=
