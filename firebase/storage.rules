rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && (request.auth.token.role == 'admin' || request.auth.token.role == 'super_admin'); }
    function smallEnough() { return request.resource == null || request.resource.size < 15 * 1024 * 1024; }
    // image/.* deliberately excludes svg+xml: an SVG can embed <script>, and
    // since storage.googleapis.com is a separate origin from the app, an
    // uploaded SVG opened directly (rather than rendered via <img>) could
    // execute script in that origin - not worth the risk for a format none
    // of the upload flows (photos, lab reports, attachments) actually need.
    function safeType() { return request.resource == null || request.resource.contentType.matches('(image/(png|jpe?g|webp|heic|heif|gif)|application/pdf)'); }
    // Separate from safeType() rather than folding audio into it, so image/PDF
    // upload paths (lab reports, profile photos) can never be used to smuggle
    // an audio file in, and vice versa.
    function safeAudioType() { return request.resource == null || request.resource.contentType.matches('audio/.*'); }
    // Program chat photos are visible to the whole batch, not just the
    // uploader - a Firestore cross-service read of the caller's own user
    // doc (never anyone else's) confirms they're an active member of the
    // exact program in the path before granting read OR write.
    function programMember(programId) {
      let profile = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      return signedIn() && profile.activeProgramId == programId && profile.programActive == true;
    }
    match /program-chat-photos/{programId}/{uid}/{allPaths=**} {
      allow read: if programMember(programId) || admin();
      allow write: if owner(uid) && programMember(programId) && smallEnough() && safeType();
    }
    match /program-chat-audio/{programId}/{uid}/{allPaths=**} {
      allow read: if programMember(programId) || admin();
      allow write: if owner(uid) && programMember(programId) && smallEnough() && safeAudioType();
    }
    match /users/{uid}/{allPaths=**} { allow read, write: if (owner(uid) || admin()) && smallEnough() && safeType(); }
    match /meal-photos/{uid}/{allPaths=**} { allow read, write: if (owner(uid) || admin()) && smallEnough() && safeType(); }
    match /lab-reports/{uid}/{allPaths=**} { allow read, write: if (owner(uid) || admin()) && smallEnough() && safeType(); }
    match /consultation-attachments/{uid}/{allPaths=**} { allow read, write: if (owner(uid) || admin()) && smallEnough() && safeType(); }
    match /reports/{uid}/{allPaths=**} { allow read: if owner(uid) || admin(); allow write: if admin(); }
    match /content/{allPaths=**} { allow read: if true; allow write: if admin() && smallEnough() && safeType(); }
    match /products/{allPaths=**} { allow read: if true; allow write: if admin() && smallEnough() && safeType(); }
  }
}
