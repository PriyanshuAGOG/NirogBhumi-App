rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function role(name) { return signedIn() && (request.auth.token.role == name || ('roles' in request.auth.token && request.auth.token.roles is list && name in request.auth.token.roles)); }
    function admin() { return role('admin') || role('super_admin'); }
    function expert() { return role('expert'); }
    function coach() { return role('coach'); }
    // Program-management staff: admins and coaches. staff() alone is
    // deliberately still used for platform-wide surfaces (moderation review
    // queue routing, support inbox) where any staff member handling any
    // ticket is fine. For anything scoped to a specific program (roster,
    // calendar, announcements, batch stats, coach-to-member messages),
    // programStaff(programId) is the real boundary: admin always passes,
    // a coach only passes for the program(s) they're assigned via
    // programs/{programId}.coachId.
    function staff() { return admin() || coach(); }
    function assignedCoach(programId) {
      return coach() && programId is string && programId != ''
        && get(/databases/$(database)/documents/programs/$(programId)).data.coachId == request.auth.uid;
    }
    function programStaff(programId) { return admin() || assignedCoach(programId); }
    function assigned(uid) { return expert() && exists(/databases/$(database)/documents/expertAssignments/$(request.auth.uid + '_' + uid)); }
    function ownsResource() { return owner(resource.data.userId); }
    function ownsRequest() { return owner(request.resource.data.userId); }
    function preservesUserId() { return request.resource.data.userId == resource.data.userId; }
    function validCreate() { return ownsRequest() && request.resource.data.createdAt == request.time; }
    // Care+ (program calendar/chat) is a second layer only for people who've actually
    // enrolled in a program - both checks read the caller's own profile document.
    function programMember() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.programActive == true; }
    function ownProgram(programId) { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.activeProgramId == programId; }
    // A coach may reach a specific member's health logs / case notes only for
    // a member currently enrolled in a program that coach is assigned to:
    // member uid -> that user's activeProgramId -> that program's coachId.
    // Admins are checked separately (and always pass), so this is only ever
    // evaluated for coaches. This resolves the previously-deferred "scope
    // health-data reads to assigned members, not blanket staff()" note on
    // the health-log and coachNotes rules below - before this, ANY coach
    // could read EVERY member's diabetes/BP/medication history and lab
    // scans platform-wide, not just their own batch. Now verified by rules
    // unit tests (firestore.rules.test.mjs).
    function coachAssignedToUser(uid) {
      return coach() && uid is string
        && get(/databases/$(database)/documents/users/$(uid)).data.get('activeProgramId', '') != ''
        && get(/databases/$(database)/documents/programs/$(get(/databases/$(database)/documents/users/$(uid)).data.activeProgramId)).data.get('coachId', '') == request.auth.uid;
    }

    match /users/{uid} {
      // Same enrollment/status fields the update rule below locks down must
      // also be blocked on create, not just update - resource.data doesn't
      // exist yet for a create, so the update rule's "must match the
      // existing value" comparison can't apply here. Without this, a client
      // could self-grant Care+ enrollment (or any status) for free the
      // moment their own users/{uid} doc is created, by simply including
      // programActive/activeProgramId in that very first write - entirely
      // bypassing redeemProgramCode. Requiring these fields be absent means
      // they can only ever be set afterward by admin() or a Cloud Function
      // via the Admin SDK (which bypasses rules entirely).
      allow create: if owner(uid) && request.resource.data.userId == uid
        && (!('role' in request.resource.data) || request.resource.data.role == 'user')
        && !('status' in request.resource.data)
        && !('programActive' in request.resource.data)
        && !('activeProgramId' in request.resource.data)
        && !('activeProgramName' in request.resource.data)
        && !('programDurationDays' in request.resource.data);
      allow read: if owner(uid) || staff() || assigned(uid);
      // Role/status/enrollment fields are the actual security and billing
      // boundary of this doc, so the owner can never change them directly -
      // only admin(), or a Cloud Function via the Admin SDK (which bypasses
      // rules entirely - see redeemProgramCode / setUserRole), may set them.
      // .get(field, default) makes this airtight even when the field is
      // absent from the existing doc, unlike a plain 'in' presence check.
      // Both sides use .get() with a default. onUserCreate (an async Auth
      // trigger) sets role/status, but it can land AFTER the client's own
      // first onboarding write has already created users/{uid} (the create
      // rule allows a doc with neither field). On such a doc, a bare
      // request.resource.data.role / .status reads a missing field, which
      // errors and denies EVERY later owner update - which is exactly why a
      // brand-new device could sign up but then hit PERMISSION_DENIED on
      // every saveProfile (consent, profile setup). Defaulting both sides
      // keeps the privilege-escalation guard intact (a client sending
      // role:'admin' still fails) while letting a legit profile write through.
      allow update: if admin() || (owner(uid)
        && request.resource.data.get('role', 'user') == resource.data.get('role', 'user')
        && request.resource.data.get('status', 'active') == resource.data.get('status', 'active')
        && request.resource.data.get('programActive', false) == resource.data.get('programActive', false)
        && request.resource.data.get('activeProgramId', null) == resource.data.get('activeProgramId', null)
        && request.resource.data.get('activeProgramName', null) == resource.data.get('activeProgramName', null)
        && request.resource.data.get('programDurationDays', null) == resource.data.get('programDurationDays', null));
      allow delete: if admin();
    }
    // Fan-out copy of an announcement, one per recipient uid, written only by
    // the createAnnouncement/deleteAnnouncement Cloud Functions (Admin SDK
    // bypasses rules) - this is what AnnouncementsScreen actually reads, so a
    // member only ever sees announcements addressed to them, whatever the
    // audience (a single program, all enrolled, inactive, everyone) that
    // reached them by.
    match /users/{uid}/announcements/{id} {
      allow read: if owner(uid);
      allow write: if false;
    }
    // Immutable, timestamped consent records (DPDP Act 2023 "consent record").
    // The owner appends a receipt each time they give/withdraw consent; it can
    // never be updated or deleted, and acceptedAt must be the server time so
    // the audit trail can't be back-dated. Owner and admin may read.
    match /users/{uid}/consentReceipts/{id} {
      allow read: if owner(uid) || admin();
      allow create: if owner(uid)
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.version is string
        && request.resource.data.purposes is map;
      allow update, delete: if false;
    }
    match /profiles/{id} {
      allow create: if validCreate();
      allow read: if ownsResource() || admin() || assigned(resource.data.userId);
      allow update: if admin() || (ownsResource() && ownsRequest() && preservesUserId()) || (assigned(resource.data.userId) && preservesUserId());
      allow delete: if ownsResource() || admin();
    }
    match /{collection}/{id} {
      allow create: if collection in ['glucoseReadings','bpReadings','sleepLogs','walkLogs','weightLogs','labReports','dailyCheckins','checklistLogs','medicationLogs'] && validCreate();
      // Coaches get read-only access to their members' day-to-day logs (Care+
      // console health monitoring) alongside the member and the admin/expert
      // paths; only admin (not coach) may delete or edit another member's entry.
      // Now scoped to the member's ASSIGNED coach (coachAssignedToUser),
      // not blanket staff() - a coach can only read the health data of a
      // member currently in their own batch. Admin still reads any; the
      // member always reads their own; an assigned expert path is preserved.
      allow read: if collection in ['glucoseReadings','bpReadings','sleepLogs','walkLogs','weightLogs','labReports','dailyCheckins','checklistLogs','medicationLogs'] && (ownsResource() || admin() || coachAssignedToUser(resource.data.userId) || assigned(resource.data.userId));
      allow delete: if collection in ['glucoseReadings','bpReadings','sleepLogs','walkLogs','weightLogs','labReports','dailyCheckins','checklistLogs','medicationLogs'] && (ownsResource() || admin() || assigned(resource.data.userId));
      allow update: if collection in ['glucoseReadings','bpReadings','sleepLogs','walkLogs','weightLogs','labReports','dailyCheckins','checklistLogs','medicationLogs'] && (admin() || (ownsResource() && ownsRequest() && preservesUserId()) || (assigned(resource.data.userId) && preservesUserId()));
    }
    match /consultations/{id} {
      allow create: if validCreate() && request.resource.data.paymentStatus == 'pending' && request.resource.data.status in ['pending', 'payment_pending'];
      allow read: if ownsResource() || staff() || (expert() && resource.data.expertId == request.auth.uid);
      allow update: if admin() || (expert() && resource.data.expertId == request.auth.uid && request.resource.data.expertId == resource.data.expertId && preservesUserId()) || (ownsResource() && ownsRequest() && preservesUserId() && request.resource.data.paymentStatus == resource.data.paymentStatus && request.resource.data.status == resource.data.status);
    }
    match /{collection}/{id} {
      allow read: if collection in ['dailyActions','weeklyReports','sugarStories','userPrograms','programPlans','expertNotes','notifications','deviceConnections','orders'] && (ownsResource() || admin() || assigned(resource.data.userId));
      allow create: if collection == 'deviceConnections' && ownsRequest();
      allow update: if collection == 'deviceConnections' && ownsResource() && ownsRequest() && preservesUserId();
      allow create: if collection == 'orders' && validCreate() && request.resource.data.paymentStatus == 'pending' && request.resource.data.orderStatus == 'pending';
      // The device itself (local reminder fired, FCM message received) is the
      // one recording that a notification happened, so a self-scoped create
      // is safe - it can only ever write an entry claiming to be its own
      // user. It must never be able to set status/scheduledFor/type though:
      // those are what makes sendPendingNotifications() pick a doc up and
      // push it, so without this guard a client could self-create a
      // status:'scheduled' doc to flood the shared 100-per-15-minute
      // processing queue and crowd out (or bypass quiet hours/caps for)
      // other users' - including critical health - alerts.
      allow create: if collection == 'notifications' && validCreate()
        && !('status' in request.resource.data)
        && !('scheduledFor' in request.resource.data)
        && !('type' in request.resource.data);
    }
    match /contentItems/{id} { allow read: if resource.data.status == 'published' || admin(); allow write: if admin() || role('content_manager'); }
    // Self-update system release metadata, one doc per channel (id ==
    // channel name: 'production'|'testing'|'development'). Public read since
    // this is non-sensitive release info the app needs before the user is
    // necessarily signed in (or even mid-login); writes only ever come from
    // CI's WIF-authenticated Admin SDK, which bypasses rules entirely - the
    // admin()-only write here is defense-in-depth against a compromised
    // client, not the real write path.
    match /appUpdates/{channel} { allow read: if true; allow write: if admin(); }
    // Program docs hold the plaintext invite/redemption code, so a public
    // signedIn() read would let anyone list every program's code and
    // self-enroll - staff-only read; redemption goes through the
    // redeemProgramCode Cloud Function instead of a direct client read.
    // A coach only sees/edits the program(s) they're assigned to (per-batch
    // scoping); only admin creates/deletes programs or reassigns a coach.
    match /programs/{id} {
      allow read: if admin() || (coach() && resource.data.coachId == request.auth.uid);
      allow create, delete: if admin();
      allow update: if admin() || (coach() && resource.data.coachId == request.auth.uid && request.resource.data.coachId == resource.data.coachId);
    }
    // Composed exclusively through the createAnnouncement Cloud Function now
    // (targeting can cross program boundaries - all users, all enrolled,
    // inactive, non-enrolled - which needs the Admin SDK to resolve, not a
    // client write a rule could scope by a single programId). This doc is
    // staff-only: the console's "past announcements" list. Every recipient's
    // own copy lives under users/{uid}/announcements instead - that's what
    // the Android app reads from, and it's what used to be readable here by
    // any enrolled member of *any* program, not just staff.
    match /announcements/{id} {
      allow read: if staff();
      allow write: if false;
    }
    match /programChatMessages/{id} {
      allow read: if programMember() && ownProgram(resource.data.programId);
      allow create: if programMember() && ownProgram(request.resource.data.programId) && request.resource.data.userId == request.auth.uid && request.resource.data.createdAt == request.time;
      // Reactions are the one thing any batchmate (not just the author) can
      // touch on someone else's message - restricted to only that field so
      // a member can never edit another member's text via this path.
      // Pinning (like announcements) is a staff action, scoped to the coach
      // assigned to that specific program - checked separately from the
      // reactions branch so a member can never smuggle a pin through by
      // also including 'reactions' in the same write.
      allow update: if (programMember() && ownProgram(resource.data.programId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']))
        || (programStaff(resource.data.programId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned', 'pinnedBy', 'pinnedAt']));
    }
    // Ephemeral "X is typing..." presence, one doc per (program, member).
    // Not field-restricted like programChatMessages since there's nothing
    // here to protect beyond ownership - the client fully controls its own
    // typing doc's shape, there's no cross-member field to lock down.
    match /programTypingStatus/{id} {
      allow read: if programMember() && ownProgram(resource.data.programId);
      allow create, update: if programMember() && ownProgram(request.resource.data.programId) && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /reportedMessages/{id} {
      // Any program member can report a message they can see; reviewed by
      // admin or the coach assigned to that report's program.
      allow create: if programMember() && request.resource.data.reporterId == request.auth.uid && request.resource.data.createdAt == request.time;
      allow read, update: if programStaff(resource.data.programId);
    }
    match /consultationSlots/{id} {
      allow read: if signedIn() && resource.data.active == true;
      // Scoped to the owning expert - expert() alone would let any expert
      // edit or disable a colleague's availability slots.
      allow create: if admin() || (expert() && request.resource.data.expertId == request.auth.uid);
      allow update, delete: if admin() || (expert() && resource.data.expertId == request.auth.uid);
    }
    match /expertAssignments/{id} { allow read: if admin() || (expert() && resource.data.expertId == request.auth.uid); allow write: if admin(); }
    match /{collection}/{id} {
      // Client-side create used to only check validCreate() (ownership +
      // server timestamp) - no awareness of requestDataExport's 60-minute
      // cooldown or any limit at all on requestAccountDeletion, so a script
      // could skip both callables entirely and write either collection
      // directly, unthrottled (each dataExportRequests doc alone triggers
      // ~19 collection reads + a permanent Storage file write). Both
      // callables already write via the Admin SDK, which always bypasses
      // this rule regardless - so denying client creates outright costs
      // the legitimate flow nothing and closes the direct-write bypass.
      allow create: if false;
      allow read: if collection in ['dataExportRequests','deletionRequests'] && (ownsResource() || admin());
      allow update: if admin();
    }
    match /auditLogs/{id} { allow read: if admin(); allow write: if false; }
    match /supportRequests/{id} {
      allow create: if validCreate() && request.resource.data.status == 'open';
      allow read: if ownsResource() || staff();
      allow update: if staff();
    }
    // Client-side error telemetry (CloudResult.Failure surfaced to a real
    // user) - the caller can only ever report on their own behalf (never
    // forge another uid's report) and can never read reports back, so this
    // can't be abused as a side-channel to enumerate other users' errors.
    // The console's Error Reports page is admin-only in its route gating
    // (App.tsx Protected adminOnly) - the rule matches that here instead of
    // the broader staff(), so a coach can't bypass the UI and read/resolve
    // platform-wide crash telemetry directly via the Firestore SDK.
    match /errorReports/{id} {
      allow create: if validCreate() && request.resource.data.resolved == false;
      allow read, update: if admin();
    }
    // Care+ program calendar. Members read events for the program they're
    // enrolled in; only admin or that program's assigned coach create/edit.
    match /programEvents/{id} {
      allow read: if programStaff(resource.data.programId) || ownProgram(resource.data.programId);
      allow create: if programStaff(request.resource.data.programId) && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if programStaff(resource.data.programId);
    }
    // Batch roster. A member may read only their own membership doc (the
    // roster itself is staff-only, so member names never leak between members);
    // batch-level presence reaches members via batchStats, not this collection.
    match /programMembers/{id} {
      allow read: if programStaff(resource.data.programId) || (signedIn() && resource.data.uid == request.auth.uid);
      // Enrollment goes through the redeemProgramCode Cloud Function (Admin
      // SDK, bypasses rules), which validates the code and creates this
      // roster entry itself - the roster is never client-writable, so a
      // member can't plant a doc for a program they didn't redeem a code
      // for, or forge their own contributionKm/lastCheckinAt stats.
      allow create: if programStaff(request.resource.data.programId);
      // A member may also touch their own doc, but only these self-service
      // fields - the two unread-badge read markers, and leaderboardOptIn
      // (opt-in batch leaderboard: a member chooses whether their own name
      // appears, never contributionKm/lastCheckinAt/status/name themselves,
      // which stay staff (or Cloud Function)-only above.
      allow update: if programStaff(resource.data.programId)
        || (signedIn() && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadGeneralAt', 'lastReadAnnouncementsAt', 'leaderboardOptIn']));
      allow delete: if programStaff(resource.data.programId);
    }
    // Aggregated, PII-free batch counts written by Cloud Functions only. Members
    // read the stats for the program they're enrolled in (cooperative presence).
    match /batchStats/{id} {
      allow read: if programStaff(resource.data.programId) || ownProgram(resource.data.programId);
      allow write: if false;
    }
    // Program access codes - sensitive, and scoped like programs/
    // programEvents above: admin always passes, a coach only for the
    // program(s) they're actually assigned to (matches the programId field
    // every code doc already carries) - a plain staff() here let any coach
    // read or rewrite any other coach's program's join code, not just
    // their own.
    match /programCodes/{id} {
      allow read, update, delete: if programStaff(resource.data.programId);
      allow create: if programStaff(request.resource.data.programId);
    }
    // Private coach-to-member notes. The recipient may read their own; only
    // admin or that program's assigned coach can send.
    match /coachMessages/{id} {
      allow read: if programStaff(resource.data.programId) || (signedIn() && resource.data.toUid == request.auth.uid);
      allow create: if programStaff(request.resource.data.programId) && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if programStaff(resource.data.programId);
    }
    // Async "ask your coach" inbox - a private two-way thread per (program,
    // member) pair, separate from the group programChatMessages and from the
    // one-directional coachMessages notes above. memberUid is whose thread a
    // message belongs to; fromUid is who actually wrote it (the member, or
    // that program's staff replying). A member only ever sees their own
    // thread - never another member's questions - while program staff see
    // every thread in their own program only. Immutable once sent (no edit/
    // delete), matching the audit posture of the group chat.
    match /coachInboxMessages/{id} {
      allow read: if programStaff(resource.data.programId)
        || (signedIn() && resource.data.memberUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && (
          (request.resource.data.memberUid == request.auth.uid && ownProgram(request.resource.data.programId))
          || programStaff(request.resource.data.programId)
        );
      allow update, delete: if false;
    }
    // Coach-only case notes on a member, for consultation prep. Members never
    // see these. Now scoped to the member's assigned coach (or admin), same
    // as the health-log rule above: a coach can only read/write case notes
    // for a member in their own batch, not every member platform-wide.
    match /coachNotes/{id} {
      allow read, delete: if admin() || coachAssignedToUser(resource.data.targetUid);
      allow create: if (admin() || coachAssignedToUser(request.resource.data.targetUid))
        && request.resource.data.authorId == request.auth.uid && request.resource.data.createdAt == request.time;
      // Editing a note can't reassign who wrote it or which member it's
      // about - otherwise any staff member could rewrite authorship history
      // or quietly move a note onto a different member's file.
      allow update: if (admin() || coachAssignedToUser(resource.data.targetUid))
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.targetUid == resource.data.targetUid;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
