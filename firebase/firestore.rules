rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function role(name) { return signedIn() && (request.auth.token.role == name || ('roles' in request.auth.token && request.auth.token.roles is list && name in request.auth.token.roles)); }
    function admin() { return role('admin') || role('super_admin'); }
    function expert() { return role('expert'); }
    function coach() { return role('coach'); }
    // Program-management staff: admins and coaches. staff() alone is
    // deliberately still used for platform-wide surfaces (moderation review
    // queue routing, support inbox) where any staff member handling any
    // ticket is fine. For anything scoped to a specific program (roster,
    // calendar, announcements, batch stats, coach-to-member messages),
    // programStaff(programId) is the real boundary: admin always passes,
    // a coach only passes for the program(s) they're assigned via
    // programs/{programId}.coachId.
    function staff() { return admin() || coach(); }
    function assignedCoach(programId) {
      return coach() && programId is string && programId != ''
        && get(/databases/$(database)/documents/programs/$(programId)).data.coachId == request.auth.uid;
    }
    function programStaff(programId) { return admin() || assignedCoach(programId); }
    function assigned(uid) { return expert() && exists(/databases/$(database)/documents/expertAssignments/$(request.auth.uid + '_' + uid)); }
    function ownsResource() { return owner(resource.data.userId); }
    function ownsRequest() { return owner(request.resource.data.userId); }
    function preservesUserId() { return request.resource.data.userId == resource.data.userId; }
    function validCreate() { return ownsRequest() && request.resource.data.createdAt == request.time; }
    // Care+ (program calendar/chat) is a second layer only for people who've actually
    // enrolled in a program - both checks read the caller's own profile document.
    function programMember() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.programActive == true; }
    function ownProgram(programId) { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.activeProgramId == programId; }

    match /users/{uid} {
      allow create: if owner(uid) && request.resource.data.userId == uid && (!('role' in request.resource.data) || request.resource.data.role == 'user');
      allow read: if owner(uid) || staff() || assigned(uid);
      // Role/status/enrollment fields are the actual security and billing
      // boundary of this doc, so the owner can never change them directly -
      // only admin(), or a Cloud Function via the Admin SDK (which bypasses
      // rules entirely - see redeemProgramCode / setUserRole), may set them.
      // .get(field, default) makes this airtight even when the field is
      // absent from the existing doc, unlike a plain 'in' presence check.
      allow update: if admin() || (owner(uid)
        && request.resource.data.role == resource.data.get('role', 'user')
        && request.resource.data.status == resource.data.get('status', 'active')
        && request.resource.data.get('programActive', false) == resource.data.get('programActive', false)
        && request.resource.data.get('activeProgramId', null) == resource.data.get('activeProgramId', null)
        && request.resource.data.get('activeProgramName', null) == resource.data.get('activeProgramName', null)
        && request.resource.data.get('programDurationDays', null) == resource.data.get('programDurationDays', null));
      allow delete: if admin();
    }
    match /profiles/{id} {
      allow create: if validCreate();
      allow read: if ownsResource() || admin() || assigned(resource.data.userId);
      allow update: if admin() || (ownsResource() && ownsRequest() && preservesUserId()) || (assigned(resource.data.userId) && preservesUserId());
      allow delete: if ownsResource() || admin();
    }
    match /{collection}/{id} {
      allow create: if collection in ['glucoseReadings','bpReadings','sleepLogs','walkLogs','weightLogs','labReports','dailyCheckins','checklistLogs','medicationLogs'] && validCreate();
      // Coaches get read-only access to their members' day-to-day logs (Care+
      // console health monitoring) alongside the member and the admin/expert
      // paths; only admin (not coach) may delete or edit another member's entry.
      // Deliberately staff()-wide rather than programStaff()-scoped, unlike
      // programs/programEvents/programMembers/announcements/coachMessages
      // above: scoping this to "coach assigned to this member's program"
      // would need chaining member uid -> activeProgramId -> that program's
      // coachId, and health data read access is exactly where an untested
      // rule bug would be worst - revisit alongside coachNotes once rules
      // unit tests exist.
      allow read: if collection in ['glucoseReadings','bpReadings','sleepLogs','walkLogs','weightLogs','labReports','dailyCheckins','checklistLogs','medicationLogs'] && (ownsResource() || staff() || assigned(resource.data.userId));
      allow delete: if collection in ['glucoseReadings','bpReadings','sleepLogs','walkLogs','weightLogs','labReports','dailyCheckins','checklistLogs','medicationLogs'] && (ownsResource() || admin() || assigned(resource.data.userId));
      allow update: if collection in ['glucoseReadings','bpReadings','sleepLogs','walkLogs','weightLogs','labReports','dailyCheckins','checklistLogs','medicationLogs'] && (admin() || (ownsResource() && ownsRequest() && preservesUserId()) || (assigned(resource.data.userId) && preservesUserId()));
    }
    match /consultations/{id} {
      allow create: if validCreate() && request.resource.data.paymentStatus == 'pending' && request.resource.data.status in ['pending', 'payment_pending'];
      allow read: if ownsResource() || staff() || (expert() && resource.data.expertId == request.auth.uid);
      allow update: if admin() || (expert() && resource.data.expertId == request.auth.uid && request.resource.data.expertId == resource.data.expertId && preservesUserId()) || (ownsResource() && ownsRequest() && preservesUserId() && request.resource.data.paymentStatus == resource.data.paymentStatus && request.resource.data.status == resource.data.status);
    }
    match /{collection}/{id} {
      allow read: if collection in ['dailyActions','weeklyReports','sugarStories','userPrograms','programPlans','expertNotes','notifications','deviceConnections','orders'] && (ownsResource() || admin() || assigned(resource.data.userId));
      allow create: if collection == 'deviceConnections' && ownsRequest();
      allow update: if collection == 'deviceConnections' && ownsResource() && ownsRequest() && preservesUserId();
      allow create: if collection == 'orders' && validCreate() && request.resource.data.paymentStatus == 'pending' && request.resource.data.orderStatus == 'pending';
      // The device itself (local reminder fired, FCM message received) is the
      // one recording that a notification happened, so a self-scoped create
      // is safe - it can only ever write an entry claiming to be its own
      // user. It must never be able to set status/scheduledFor/type though:
      // those are what makes sendPendingNotifications() pick a doc up and
      // push it, so without this guard a client could self-create a
      // status:'scheduled' doc to flood the shared 100-per-15-minute
      // processing queue and crowd out (or bypass quiet hours/caps for)
      // other users' - including critical health - alerts.
      allow create: if collection == 'notifications' && validCreate()
        && !('status' in request.resource.data)
        && !('scheduledFor' in request.resource.data)
        && !('type' in request.resource.data);
    }
    match /contentItems/{id} { allow read: if resource.data.status == 'published' || admin(); allow write: if admin() || role('content_manager'); }
    // Program docs hold the plaintext invite/redemption code, so a public
    // signedIn() read would let anyone list every program's code and
    // self-enroll - staff-only read; redemption goes through the
    // redeemProgramCode Cloud Function instead of a direct client read.
    // A coach only sees/edits the program(s) they're assigned to (per-batch
    // scoping); only admin creates/deletes programs or reassigns a coach.
    match /programs/{id} {
      allow read: if admin() || (coach() && resource.data.coachId == request.auth.uid);
      allow create, delete: if admin();
      allow update: if admin() || (coach() && resource.data.coachId == request.auth.uid && request.resource.data.coachId == resource.data.coachId);
    }
    match /announcements/{id} {
      allow read: if programMember() || programStaff(resource.data.programId);
      allow create: if programStaff(request.resource.data.programId) && request.resource.data.authorId == request.auth.uid && request.resource.data.createdAt == request.time;
    }
    match /programChatMessages/{id} {
      allow read: if programMember() && ownProgram(resource.data.programId);
      allow create: if programMember() && ownProgram(request.resource.data.programId) && request.resource.data.userId == request.auth.uid && request.resource.data.createdAt == request.time;
      // Reactions are the one thing any batchmate (not just the author) can
      // touch on someone else's message - restricted to only that field so
      // a member can never edit another member's text via this path.
      allow update: if programMember() && ownProgram(resource.data.programId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
    }
    match /reportedMessages/{id} {
      // Any program member can report a message they can see; reviewed by
      // admin or the coach assigned to that report's program.
      allow create: if programMember() && request.resource.data.reporterId == request.auth.uid && request.resource.data.createdAt == request.time;
      allow read, update: if programStaff(resource.data.programId);
    }
    match /consultationSlots/{id} {
      allow read: if signedIn() && resource.data.active == true;
      // Scoped to the owning expert - expert() alone would let any expert
      // edit or disable a colleague's availability slots.
      allow create: if admin() || (expert() && request.resource.data.expertId == request.auth.uid);
      allow update, delete: if admin() || (expert() && resource.data.expertId == request.auth.uid);
    }
    match /expertAssignments/{id} { allow read: if admin() || (expert() && resource.data.expertId == request.auth.uid); allow write: if admin(); }
    match /{collection}/{id} {
      allow create: if collection in ['dataExportRequests','deletionRequests'] && validCreate();
      allow read: if collection in ['dataExportRequests','deletionRequests'] && (ownsResource() || admin());
      allow update: if admin();
    }
    match /auditLogs/{id} { allow read: if admin(); allow write: if false; }
    match /supportRequests/{id} {
      allow create: if validCreate() && request.resource.data.status == 'open';
      allow read: if ownsResource() || staff();
      allow update: if staff();
    }
    // Care+ program calendar. Members read events for the program they're
    // enrolled in; only admin or that program's assigned coach create/edit.
    match /programEvents/{id} {
      allow read: if programStaff(resource.data.programId) || ownProgram(resource.data.programId);
      allow create: if programStaff(request.resource.data.programId) && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if programStaff(resource.data.programId);
    }
    // Batch roster. A member may read only their own membership doc (the
    // roster itself is staff-only, so member names never leak between members);
    // batch-level presence reaches members via batchStats, not this collection.
    match /programMembers/{id} {
      allow read: if programStaff(resource.data.programId) || (signedIn() && resource.data.uid == request.auth.uid);
      // Enrollment goes through the redeemProgramCode Cloud Function (Admin
      // SDK, bypasses rules), which validates the code and creates this
      // roster entry itself - the roster is never client-writable, so a
      // member can't plant a doc for a program they didn't redeem a code
      // for, or forge their own contributionKm/lastCheckinAt stats.
      allow create: if programStaff(request.resource.data.programId);
      allow update, delete: if programStaff(resource.data.programId);
    }
    // Aggregated, PII-free batch counts written by Cloud Functions only. Members
    // read the stats for the program they're enrolled in (cooperative presence).
    match /batchStats/{id} {
      allow read: if programStaff(resource.data.programId) || ownProgram(resource.data.programId);
      allow write: if false;
    }
    // Program access codes - sensitive, staff-managed only.
    match /programCodes/{id} {
      allow read, write: if staff();
    }
    // Private coach-to-member notes. The recipient may read their own; only
    // admin or that program's assigned coach can send.
    match /coachMessages/{id} {
      allow read: if programStaff(resource.data.programId) || (signedIn() && resource.data.toUid == request.auth.uid);
      allow create: if programStaff(request.resource.data.programId) && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if programStaff(resource.data.programId);
    }
    // Coach-only case notes on a member, for consultation prep. Members never
    // see these - staff-only end to end. Deliberately not scoped to
    // programStaff() like the collections above: that would need chaining
    // two get() calls (member uid -> their activeProgramId -> that
    // program's coachId) per note, and this is lower-stakes than a coach
    // being able to broadcast/manage a batch they don't own. Revisit once
    // rules unit tests exist to verify a chained check like that actually
    // behaves as intended.
    match /coachNotes/{id} {
      allow read, delete: if staff();
      allow create: if staff() && request.resource.data.authorId == request.auth.uid && request.resource.data.createdAt == request.time;
      // Editing a note can't reassign who wrote it or which member it's
      // about - otherwise any staff member could rewrite authorship history
      // or quietly move a note onto a different member's file.
      allow update: if staff()
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.targetUid == resource.data.targetUid;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
